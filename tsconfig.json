{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["extension", "shared"]
}
